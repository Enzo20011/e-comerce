PORT=5201

# Obligatorio en producción (mín. 32 caracteres): openssl rand -base64 48
# ADMIN_JWT_SECRET=
# Solo se usa para crear el admin inicial (producción: mín. 12 caracteres)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
NODE_ENV=development
# Dominios permitidos por CORS, separados por coma (vacío = solo mismo origen)
# CORS_ORIGIN=https://mitienda.com
# Cantidad de proxies delante del server (nginx/Cloudflare = 1)
# TRUST_PROXY=1
# Backups automáticos (producción): carpeta, cantidad a conservar y desactivar
# BACKUP_DIR=/var/backups/tienda
# BACKUP_KEEP=14
# BACKUP_ENABLED=true
# Redirección a HTTPS detrás de un proxy (por defecto activa en producción con TRUST_PROXY)
# FORCE_HTTPS=true
